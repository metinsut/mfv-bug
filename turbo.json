{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "lint:unsafe": {
      "cache": false
    },
    "clear": {
      "cache": false
    },
    "orval": {
      "cache": false,
      "dependsOn": ["^orval"]
    }
  },
  "globalEnv": ["Bun"]
}
